# ConversationIQ Configuration Example
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=sqlite:///./data/conversationiq.db

# API Keys (if you want to store them here instead of CLI)
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/conversationiq.log

# TinyTroupe Configuration (optional)
# TINYTROUPE_API_KEY=your_tinytroupe_key_if_needed
